    "exp_hi": "<strong>विस्तृत समाधान:</strong><br>'It is high time' के बाद भूतकाल (clarified) का प्रयोग होता है, 'clarifies' का नहीं। त्रुटि भाग <strong>(2)</strong> में है।"
  },
  {
    "id": 100,
    "sec": 3,
    "tag": "English",
    "q_en": "Convert the sentence provided below from its passive voice structure to an active voice structure:\nThe decision is not expected to be reversed by the board despite ongoing protests.",
    "q_hi": "Convert the sentence provided below from its passive voice structure to an active voice structure:\nThe decision is not expected to be reversed by the board despite ongoing protests.",
    "opts_en": [
      "Ongoing protests will force the board to reverse the decision.",
      "The board is not expected to reverse the decision despite ongoing protests.",
      "It is not expected that the board protests against the decision.",
      "Protesters expect the board not to reverse the decision."
    ],
    "opts_hi": [
      "Ongoing protests will force the board to reverse the decision.",
      "The board is not expected to reverse the decision despite ongoing protests.",
      "It is not expected that the board protests against the decision.",
      "Protesters expect the board not to reverse the decision."
    ],
    "ans": 1,
    "exp_en": "<strong>Detailed Solution:</strong><br>Active voice: <strong>The board is not expected to reverse the decision despite ongoing protests.</strong>",
    "exp_hi": "<strong>विस्तृत समाधान:</strong><br>सही सक्रिय वाच्य (Active Voice) है: <strong>The board is not expected to reverse the decision despite ongoing protests.</strong>"
  }
];

const sectionTitles = [
  "PART-A: Reasoning",
  "PART-B: General Awareness",
  "PART-C: Quantitative Aptitude",
  "PART-D: English Comprehension"
];

let currentSection = 0;
let currentQIndex = 0;
let currentLang = 'hi';
let userAnswers = new Array(questions.length).fill(null);
let markedStatus = new Array(questions.length).fill(false);
let timeSpentPerQ = new Array(questions.length).fill(0);
let isTestCompleted = false;

let sectionSecondsRemaining = 15 * 60;
let sectionTimerInterval = null;
let questionTimerInterval = null;
let totalExamSecondsTaken = 0;

let savedQuestionIds = JSON.parse(localStorage.getItem('ssc_30sep_s2_saved') || '[]');
let trajectoryChartInstance = null;

function formatTime(s) {
  const m = Math.floor(s / 60);
  const rem = s % 60;
  return `${m.toString().padStart(2, '0')}:${rem.toString().padStart(2, '0')}`;
}

function toggleLanguage() {
  currentLang = (currentLang === 'en') ? 'hi' : 'en';
  document.getElementById('lang-toggle-btn').innerText = (currentLang === 'en') ? 'हिन्दी' : 'English';
  renderQuestion(currentQIndex);
}

function startTest() {
  document.getElementById('lang-select-modal').style.display = 'flex';
}

function closeLangModalOnBackdrop(e) {
  if (e.target.id === 'lang-select-modal') {
    document.getElementById('lang-select-modal').style.display = 'none';
  }
}

function beginTestWithLanguage(lang) {
  currentLang = (lang === 'en') ? 'en' : 'hi';
  document.getElementById('lang-toggle-btn').innerText = (currentLang === 'en') ? 'हिन्दी' : 'English';
  document.getElementById('lang-select-modal').style.display = 'none';
  document.getElementById('instruction-screen').style.display = 'none';
  document.getElementById('test-screen').style.display = 'flex';
  loadSection(0);
}

function loadSection(secIdx) {
  currentSection = secIdx;
  document.getElementById('current-section-title').innerText = sectionTitles[secIdx];
  document.getElementById('drawer-active-sec-badge').innerText = `${sectionTitles[secIdx].split(': ')[1]} (Questions ${secIdx * 25 + 1} - ${secIdx * 25 + 25})`;

  for (let i = 0; i < 4; i++) {
    const tab = document.getElementById(`sec-tab-${i}`);
    tab.className = 'section-tab';
    if (i < currentSection) tab.classList.add('locked-done');
    else if (i === currentSection) tab.classList.add('active');
  }

  sectionSecondsRemaining = 15 * 60;
  startSectionTimer();
  buildSectionFilteredPalette();
  renderQuestion(secIdx * 25);
}

function startSectionTimer() {
  clearInterval(sectionTimerInterval);
  const display = document.getElementById('section-timer-display');
  display.innerText = formatTime(sectionSecondsRemaining);
  display.parentElement.classList.remove('low');

  sectionTimerInterval = setInterval(() => {
    totalExamSecondsTaken++;
    if (sectionSecondsRemaining <= 0) {
      clearInterval(sectionTimerInterval);
      showTimeUp();
      return;
    }
    sectionSecondsRemaining--;
    display.innerText = formatTime(sectionSecondsRemaining);
    display.parentElement.classList.toggle('low', sectionSecondsRemaining <= 60);
  }, 1000);
}

function showTimeUp() {
  closePalette(); closeSubmitModal();
  const last = currentSection === 3;
  document.getElementById('modal-heading-text').innerText = "Time is Up";
  document.getElementById('modal-subtext').innerText = last 
    ? 'All sections are finished. Your exam is submitting automatically.'
    : `${sectionTitles[currentSection].split(': ')[1]} is now locked. Advancing to next section.`;
  openSubmitModal();
}

function startQTimer() {
  stopQTimer();
  updateQTimerDisplay();
  if (isTestCompleted) return;
  questionTimerInterval = setInterval(() => {
    timeSpentPerQ[currentQIndex]++;
    updateQTimerDisplay();
  }, 1000);
}

function stopQTimer() {
  if (questionTimerInterval) { clearInterval(questionTimerInterval); questionTimerInterval = null; }
}

function updateQTimerDisplay() {
  document.getElementById('per-q-timer-text').innerText = formatTime(timeSpentPerQ[currentQIndex]);
}

function renderQuestion(idx) {
  currentQIndex = idx;
  const q = questions[idx];
  
  if (isTestCompleted) {
    for (let i = 0; i < 4; i++) {
      document.getElementById(`sec-tab-${i}`).className = 'section-tab' + (i === q.sec ? ' active' : '');
    }
  }

  document.getElementById('curr-q-no').innerText = idx + 1;
  document.getElementById('exam-tag-text').innerText = q.tag;
  const qTextBox = document.getElementById('question-text');
  qTextBox.innerHTML = (currentLang === 'hi') ? q.q_hi : q.q_en;
  if (q.q_img) {
    const imgWrap = document.createElement('div');
    imgWrap.className = 'q-img-wrap';
    const imgEl = document.createElement('img');
    imgEl.src = q.q_img;
    imgEl.alt = 'Question Figure';
    imgWrap.appendChild(imgEl);
    if (q.q_img_extra) {
      const imgExtraEl = document.createElement('img');
      imgExtraEl.src = q.q_img_extra;
      imgExtraEl.alt = 'Answer Figures';
      imgWrap.appendChild(imgExtraEl);
    }
    qTextBox.appendChild(imgWrap);
  }

  startQTimer();
  updateNavButtonsState();

  const markBtn = document.getElementById('mark-btn');
  if (markedStatus[idx]) {
    markBtn.innerText = "Unmark Review";
    markBtn.classList.add('marked');
  } else {
    markBtn.innerText = "Mark for Review";
    markBtn.classList.remove('marked');
  }

  updateSaveBtnUI();

  const optionsBox = document.getElementById('options-box');
  optionsBox.innerHTML = '';
  const letters = ['A', 'B', 'C', 'D'];
  const opts = (currentLang === 'hi') ? q.opts_hi : q.opts_en;

  opts.forEach((optText, optIdx) => {
    const item = document.createElement('button');
    item.type = 'button';
    item.className = 'option-item';

    if (!isTestCompleted) {
      // Live Exam Mode: only highlight selected choice
      if (userAnswers[idx] === optIdx) {
        item.classList.add('selected-live');
      }
      item.onclick = () => selectOptionLive(optIdx);
    } else {
      // Review Mode: lock buttons and reveal correct/incorrect answers
      item.classList.add('is-locked');
      if (optIdx === q.ans) item.classList.add('correct-ans');
      else if (userAnswers[idx] === optIdx) item.classList.add('wrong-ans');
    }

    const optContent = (q.opts_img && q.opts_img[optIdx])
      ? `<span class="opt-img-wrap"><img src="${q.opts_img[optIdx]}" alt="Option ${letters[optIdx]}"></span>`
      : `<span class="opt-text">${optText}</span>`;
    item.innerHTML = `<span class="opt-key">${letters[optIdx]}</span>${optContent}`;
    optionsBox.appendChild(item);
  });

  // Solution Box visibility: ONLY VISIBLE AFTER SUBMISSION
  const expBox = document.getElementById('explanation-container');
  if (isTestCompleted) {
    expBox.style.display = 'block';
    const expText = (currentLang === 'hi') ? q.exp_hi : q.exp_en;
    expBox.innerHTML = `
      <div class="exp-badge-correct">Official Answer Key: Option ${letters[q.ans]}</div>
      <div class="exp-section-block">
        <div class="exp-heading-label">Step-by-Step Explanation:</div>
        ${expText}
      </div>
    `;
  } else {
    expBox.style.display = 'none';
  }

  updateSectionStats();
  refreshPaletteClasses();
}

function selectOptionLive(optIdx) {
  if (userAnswers[currentQIndex] === optIdx) {
    userAnswers[currentQIndex] = null; // deselect if clicked again
  } else {
    userAnswers[currentQIndex] = optIdx;
  }
  renderQuestion(currentQIndex);
}

function toggleMarkReview() {
  markedStatus[currentQIndex] = !markedStatus[currentQIndex];
  renderQuestion(currentQIndex);
}

function toggleSaveQuestion() {
  const q = questions[currentQIndex];
  const uniqueId = `30sep_s2_q${q.id}`;
  const existingIdx = savedQuestionIds.findIndex(item => item.uniqueId === uniqueId);
  if (existingIdx === -1) {
    savedQuestionIds.push({ uniqueId, ...q });
  } else {
    savedQuestionIds.splice(existingIdx, 1);
  }
  localStorage.setItem('ssc_30sep_s2_saved', JSON.stringify(savedQuestionIds));
  updateSaveBtnUI();
}

function updateSaveBtnUI() {
  const btn = document.getElementById('save-q-btn');
  const q = questions[currentQIndex];
  const isSaved = savedQuestionIds.some(item => item.uniqueId === `30sep_s2_q${q.id}`);
  if (isSaved) {
    btn.classList.add('saved-active');
    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4z"/></svg>Saved`;
  } else {
    btn.classList.remove('saved-active');
    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4z"/></svg>Save`;
  }
}

function updateNavButtonsState() {
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const analysisBtn = document.getElementById('back-analysis-btn');
  const markBtn = document.getElementById('mark-btn');

  if (isTestCompleted) {
    prevBtn.disabled = (currentQIndex === 0);
    nextBtn.disabled = (currentQIndex === questions.length - 1);
    nextBtn.innerText = "Next";
    analysisBtn.style.display = "block";
    markBtn.style.display = "none";
    return;
  }

  const secStart = currentSection * 25;
  const secEnd = secStart + 24;

  prevBtn.disabled = (currentQIndex <= secStart);
  if (currentQIndex === secEnd) {
    nextBtn.innerText = (currentSection === 3) ? "Submit Exam" : "Submit Section";
  } else {
    nextBtn.innerText = "Save & Next";
  }
}

function saveAndNext() {
  if (isTestCompleted) {
    if (currentQIndex < questions.length - 1) renderQuestion(currentQIndex + 1);
    return;
  }
  const secEnd = (currentSection * 25) + 24;
  if (currentQIndex < secEnd) {
    renderQuestion(currentQIndex + 1);
  } else {
    openSubmitModal();
  }
}

function prevQuestion() {
  if (isTestCompleted) {
    if (currentQIndex > 0) renderQuestion(currentQIndex - 1);
    return;
  }
  const secStart = currentSection * 25;
  if (currentQIndex > secStart) renderQuestion(currentQIndex - 1);
}

function updateSectionStats() {
  const secStart = currentSection * 25;
  let count = 0;
  for (let i = secStart; i < secStart + 25; i++) {
    if (userAnswers[i] !== null) count++;
  }
  document.getElementById('section-answered-badge').innerText = count;
  document.getElementById('section-prog-bar').style.width = (count / 25 * 100) + '%';
}

function buildSectionFilteredPalette() {
  const grid = document.getElementById('palette-grid');
  grid.innerHTML = '';
  const secStart = currentSection * 25;
  const secEnd = secStart + 25;

  for (let i = secStart; i < secEnd; i++) {
    const item = document.createElement('div');
    item.className = 'grid-item';
    item.id = `palette-item-${i}`;
    item.innerText = i + 1;
    item.onclick = () => { renderQuestion(i); closePalette(); };
    grid.appendChild(item);
  }
  refreshPaletteClasses();
}

function refreshPaletteClasses() {
  const secStart = currentSection * 25;
  const secEnd = secStart + 25;

  for (let i = secStart; i < secEnd; i++) {
    const item = document.getElementById(`palette-item-${i}`);
    if (!item) continue;
    item.className = 'grid-item';

    if (markedStatus[i]) item.classList.add('marked-review');
    else if (userAnswers[i] !== null) item.classList.add('answered');

    if (i === currentQIndex) item.classList.add('active-now');
  }
}

function openPalette() { buildSectionFilteredPalette(); document.getElementById('palette-drawer').style.display = 'flex'; }
function closePalette() { document.getElementById('palette-drawer').style.display = 'none'; }
function closePaletteOnBackdrop(e) { if (e.target.id === 'palette-drawer') closePalette(); }

function openSubmitModal() {
  closePalette();
  const secStart = currentSection * 25;
  let attempted = 0, marked = 0;
  for (let i = secStart; i < secStart + 25; i++) {
    if (userAnswers[i] !== null) attempted++;
    if (markedStatus[i]) marked++;
  }

  document.getElementById('modal-time-left').innerText = document.getElementById('section-timer-display').innerText;
  document.getElementById('modal-attempted').innerText = attempted;
  document.getElementById('modal-unattempted').innerText = 25 - attempted;
  document.getElementById('modal-marked').innerText = marked;

  if (currentSection === 3) {
    document.getElementById('modal-heading-text').innerText = "Submit Complete Exam";
    document.getElementById('modal-subtext').innerText = "Submitting will evaluate all 100 questions and show detailed solutions.";
    document.getElementById('modal-yes-btn').innerText = 'Submit Test';
  } else {
    document.getElementById('modal-heading-text').innerText = `Lock ${sectionTitles[currentSection].split(': ')[1]}`;
    document.getElementById('modal-subtext').innerText = "Once submitted, this section will be locked and cannot be reopened.";
    document.getElementById('modal-yes-btn').innerText = 'Lock & Continue';
  }
  document.getElementById('submit-confirm-modal').style.display = 'flex';
}

function closeSubmitModal() { document.getElementById('submit-confirm-modal').style.display = 'none'; }

function confirmSectionSubmit() {
  closeSubmitModal();
  if (currentSection < 3) {
    loadSection(currentSection + 1);
  } else {
    finalizeFullTest();
  }
}

function finalizeFullTest() {
  clearInterval(sectionTimerInterval);
  stopQTimer();
  isTestCompleted = true;

  let correct = 0, wrong = 0;
  let secScores = [0, 0, 0, 0];

  questions.forEach((q, idx) => {
    if (userAnswers[idx] !== null) {
      if (userAnswers[idx] === q.ans) {
        correct++;
        secScores[q.sec] += 2.0;
      } else {
        wrong++;
        secScores[q.sec] -= 0.5;
      }
    }
  });

  const totalMarks = Math.max(0, (correct * 2) - (wrong * 0.5));
  const accuracyRate = (correct + wrong > 0) ? Math.round((correct / (correct + wrong)) * 100) : 0;

  document.getElementById('res-avg-score').innerText = `${accuracyRate}%`;
  document.getElementById('res-total-marks').innerText = totalMarks.toFixed(1);
  const studyMins = Math.max(1, Math.round(totalExamSecondsTaken / 60));
  document.getElementById('res-study-time').innerText = `${studyMins}m`;

  for (let s = 0; s < 4; s++) {
    document.getElementById(`sec-score-${s}`).innerText = `${secScores[s].toFixed(1)} / 50`;
    document.getElementById(`sec-bar-${s}`).style.width = (Math.max(0, secScores[s]) / 50 * 100) + '%';
  }

  document.getElementById('test-screen').style.display = 'none';
  document.getElementById('dashboard-screen').style.display = 'flex';

  setTimeout(() => {
    renderDarkExactTrajectory(secScores);
  }, 200);
}

function renderDarkExactTrajectory(scores) {
  Chart.defaults.font.family = "'Hind', sans-serif";
  const ctx = document.getElementById('trajectoryLineChart').getContext('2d');
  if (trajectoryChartInstance) trajectoryChartInstance.destroy();

  const gradient = ctx.createLinearGradient(0, 0, 0, 240);
  gradient.addColorStop(0, 'rgba(0, 210, 255, 0.45)');
  gradient.addColorStop(0.5, 'rgba(0, 210, 255, 0.18)');
  gradient.addColorStop(1, 'rgba(0, 210, 255, 0.0)');

  const displayScores = [scores[3], scores[0], scores[2], scores[1]];
  const maxScore = Math.max(16, ...displayScores);
  const suggestedMax = Math.ceil(maxScore * 1.15);

  trajectoryChartInstance = new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['English', 'Reasoning', 'Quant', 'Gen Awareness'],
      datasets: [{
        label: 'Score',
        data: displayScores,
        borderColor: '#00d2ff',
        borderWidth: 4.5,
        backgroundColor: gradient,
        fill: true,
        tension: 0.45,
        pointBackgroundColor: '#00d2ff',
        pointBorderColor: '#ffffff',
        pointBorderWidth: 3.5,
        pointRadius: 8.5,
        pointHoverRadius: 11
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: '#94a3b8', font: { size: 11, weight: '700' } }
        },
        y: {
          beginAtZero: true,
          suggestedMax: suggestedMax,
          ticks: { color: '#64748b', font: { size: 11, weight: '600' } },
          grid: { color: '#1e2433' }
        }
      }
    }
  });
}

function closeDashboardToReview() {
  document.getElementById('dashboard-screen').style.display = 'none';
  document.getElementById('test-screen').style.display = 'flex';

  for (let i = 0; i < 4; i++) {
    const tab = document.getElementById(`sec-tab-${i}`);
    tab.style.cursor = 'pointer';
    tab.style.opacity = '1';
    tab.onclick = () => renderQuestion(i * 25);
  }

  document.getElementById('current-section-title').innerText = "Solutions Review Mode";
  document.getElementById('section-timer-display').innerText = "Review";

  renderQuestion(0);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function returnToDashboard() {
  document.getElementById('test-screen').style.display = 'none';
  document.getElementById('dashboard-screen').style.display = 'flex';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>
