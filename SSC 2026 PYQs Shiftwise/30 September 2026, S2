<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>SSC CGL Tier 1 Mock Test - 30 Sep Shift 2</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#17275E;--ink:#121826;--muted:#5B6578;--line:#DCE1EA;--canvas:#F2F4F8;--saffron:#D9730D;--green:#1B8A5A;--green-bg:#E7F5EE;--red:#C93B3B;--red-bg:#FCECEC;--violet:#6B4BC0;--violet-bg:#EFEBFA;--selected:#EBF2FE;--selected-border:#2962FF}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:'Hind','Noto Sans Devanagari',system-ui,sans-serif;background:var(--canvas);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums;overflow:hidden}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid #3B5BDB;outline-offset:2px}
svg{flex:none}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px}
.btn{display:block;width:100%;min-height:48px;border-radius:10px;border:1.5px solid var(--navy);background:var(--navy);color:#fff;font-weight:600;font-size:1rem}

/* Instructions Screen */
#instruction-screen{position:fixed;inset:0;z-index:500;background:#fff;display:flex;flex-direction:column;overflow-y:auto}
.inst-top{background:var(--navy);color:#fff;padding:32px 20px 26px}
.inst-wrap{max-width:680px;margin:0 auto;width:100%}
.inst-top p{color:#B9C4E8;font-size:.9rem;margin-bottom:4px}
.inst-top h1{font-size:1.7rem;line-height:1.2;font-weight:700;letter-spacing:-.01em}
.inst-facts{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}
.inst-facts div{padding:14px 10px 14px 0}
.inst-facts b{display:block;font-size:1.35rem;font-weight:700}
.inst-facts span{font-size:.8rem;color:var(--muted)}
.inst-body{padding:22px 20px;flex:1}
.inst-body h2{font-size:1rem;margin:0 0 10px}
.flow{list-style:none;counter-reset:s;display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:24px}
.flow li{counter-increment:s;border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-weight:600;font-size:.92rem}
.flow li::before{content:counter(s);display:inline-grid;place-items:center;width:22px;height:22px;margin-right:8px;border-radius:50%;background:var(--navy);color:#fff;font-size:.78rem}
.flow small{display:block;font-weight:400;color:var(--muted);font-size:.8rem;margin-left:30px}
.rules{list-style:none;display:flex;flex-direction:column;gap:12px;margin-bottom:8px}
.rules li{border-left:3px solid var(--line);padding-left:12px;color:#2B3446}
.inst-cta{position:sticky;bottom:0;background:#fff;border-top:1px solid var(--line);padding:12px 20px calc(12px + env(safe-area-inset-bottom))}
.inst-cta .btn{max-width:680px;margin:0 auto}

/* Test Area */
#test-screen{display:none;flex-direction:column;height:100%}
.top-header{background:var(--navy);color:#fff;display:flex;align-items:center;gap:10px;padding:10px 14px;padding-top:max(10px,env(safe-area-inset-top))}
.test-name{flex:1;min-width:0;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.timer-badge{display:flex;align-items:center;gap:6px;font-weight:700;font-size:1.05rem;background:rgba(255,255,255,.14);padding:5px 11px;border-radius:8px}
.timer-badge.low{background:var(--saffron)}
.lang-toggle-btn,.menu-icon{min-height:36px;border:1px solid rgba(255,255,255,.35);background:transparent;color:#fff;border-radius:8px;padding:0 12px;font-weight:600;font-size:.9rem;display:grid;place-items:center}
.menu-icon{width:40px;padding:0}
.section-bar{display:flex;background:#fff;border-bottom:1px solid var(--line)}
.section-tab{flex:1;text-align:center;padding:11px 4px;font-size:.88rem;font-weight:600;color:var(--muted);border-bottom:3px solid transparent;white-space:nowrap;opacity:.6;cursor:default}
.section-tab.active{color:var(--navy);border-bottom-color:var(--navy);opacity:1}
.section-tab.locked-done{color:var(--green);opacity:.9}
.section-tab.locked-done::before{content:"\2713\00a0"}
.meta-row{background:#fff;padding:8px 14px 0;border-bottom:1px solid var(--line)}
.meta-line{display:flex;justify-content:space-between;align-items:center;font-size:.88rem;color:var(--muted);padding-bottom:8px}
.meta-line b{color:var(--ink)}
.save-btn{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0 10px;border:1px solid var(--line);border-radius:8px;background:#fff;font-size:.85rem;font-weight:600;color:var(--muted)}
.save-btn.saved-active{color:var(--navy);border-color:var(--navy);background:#EAEEFB}
.prog{height:3px;background:var(--line);margin:0 -14px}
.prog i{display:block;height:100%;width:0;background:var(--green);transition:width .3s}
.main-content{flex:1;overflow-y:auto;padding:18px 14px 28px}
.q-inner{max-width:720px;margin:0 auto}
.q-badge-wrap{display:flex;align-items:center;gap:10px;font-size:.85rem;color:var(--muted)}
.q-badge-wrap .q-no{font-size:1rem;color:var(--ink);font-weight:700}
.exam-tag-badge{border:1px solid var(--line);background:#fff;padding:1px 9px;border-radius:6px}
.per-q-timer-badge{margin-left:auto}

.question-statement u{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px;font-weight:700;color:var(--navy);background:#EEF3FF;padding:0 3px;border-radius:3px}
.question-statement strong{font-weight:700;color:var(--ink)}
.question-statement{font-size:1.15rem;line-height:1.65;font-weight:500;white-space:pre-wrap;margin:12px 0 20px}
.options-group{display:flex;flex-direction:column;gap:10px}
.option-item{display:flex;align-items:center;gap:14px;width:100%;min-height:54px;text-align:left;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;font-size:1.05rem;transition:border-color .15s, background-color .15s}
.option-item:hover{border-color:var(--navy)}

/* Real Exam Selection State (Before Submission) */
.option-item.selected-live{border-color:var(--selected-border);background:var(--selected)}
.option-item.selected-live .opt-key{background:var(--navy);border-color:var(--navy);color:#fff}

/* Solution Mode States (After Submission) */
.option-item.is-locked{cursor:default}
.opt-key{width:28px;height:28px;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;font-weight:600;font-size:.85rem;color:var(--muted)}
.opt-text{flex:1}
.option-item.correct-ans{border-color:var(--green);background:var(--green-bg)}
.option-item.correct-ans .opt-key{background:var(--green);border-color:var(--green);color:#fff}
.option-item.correct-ans::after{content:"Correct";font-size:.8rem;font-weight:600;color:var(--green)}
.option-item.wrong-ans{border-color:var(--red);background:var(--red-bg)}
.option-item.wrong-ans .opt-key{background:var(--red);border-color:var(--red);color:#fff}
.option-item.wrong-ans::after{content:"Your answer";font-size:.8rem;font-weight:600;color:var(--red)}


/* Image Display Containers - Guaranteed Pure White Background & Clean Padding */
.q-img-wrap{width:100%;background:#FFFFFF !important;border:1px solid var(--line);border-radius:10px;padding:12px;margin:14px 0 8px;display:flex;flex-direction:column;gap:10px;justify-content:center;align-items:center;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,0.03)}
.q-img-wrap img{max-width:100%;max-height:330px;width:auto;height:auto;display:block;background:#FFFFFF !important;object-fit:contain;border-radius:4px}
.opt-img-wrap{background:#FFFFFF !important;border:1px solid #EEF1F6;border-radius:8px;padding:6px 10px;display:inline-flex;align-items:center;justify-content:center;min-height:46px}
.opt-img-wrap img{max-height:84px;max-width:100%;width:auto;height:auto;display:block;background:#FFFFFF !important;object-fit:contain}

/* Explanations & Shortcuts */
.explanation-box{display:none;margin-top:20px;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.exp-badge-correct{padding:11px 16px;background:var(--green-bg);color:var(--green);font-weight:700;border-bottom:1px solid var(--line)}
.exp-section-block{padding:14px 16px 16px;line-height:1.75}
.exp-heading-label{font-size:.85rem;font-weight:600;color:var(--muted);margin-bottom:6px}
.shortcut-block{margin-top:12px;padding:12px 14px;border-left:3.5px solid var(--saffron);background:#FFF8F0;border-radius:0 8px 8px 0}
.shortcut-title{font-weight:700;font-size:.9rem;color:var(--saffron);margin-bottom:4px;display:flex;align-items:center;gap:6px}

.footer-bar{background:#fff;border-top:1px solid var(--line);display:flex;gap:10px;padding:10px 14px calc(10px + env(safe-area-inset-bottom))}
.nav-btn{flex:1;min-height:46px;border-radius:10px;border:1.5px solid var(--line);background:#fff;font-weight:600;font-size:.95rem}
.nav-btn.primary,.nav-btn.analysis{flex:1.4;background:var(--navy);border-color:var(--navy);color:#fff}
.nav-btn.analysis{display:none}
.nav-btn.marked{border-color:var(--violet);color:var(--violet);background:var(--violet-bg)}
.nav-btn:disabled{opacity:.4;cursor:default}

/* Palette and Modals */
#palette-drawer{position:fixed;inset:0;z-index:600;background:rgba(18,24,38,.5);display:none;justify-content:flex-end}
.drawer-card{width:88%;max-width:380px;height:100%;background:#fff;display:flex;flex-direction:column;padding:18px 16px max(16px,env(safe-area-inset-bottom))}
.drawer-top{display:flex;justify-content:space-between;align-items:center}
.drawer-top h3{font-size:1.1rem}
.icon-btn{width:38px;height:38px;border:0;border-radius:8px;background:var(--canvas);font-size:1.1rem}
.drawer-sec-badge{font-size:.9rem;color:var(--muted);margin:2px 0 14px}
.legend-row{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.8rem;color:var(--muted);margin-bottom:14px}
.sq{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:5px;vertical-align:-1px;border:1.5px solid var(--line)}
.grid-container{flex:1;display:grid;grid-template-columns:repeat(5,1fr);gap:10px;overflow-y:auto;align-content:start;padding:3px}
.grid-item{aspect-ratio:1;display:grid;place-items:center;border:1.5px solid var(--line);border-radius:8px;background:#fff;font-weight:600;cursor:pointer}
.grid-item.answered{background:var(--green);border-color:var(--green);color:#fff}
.grid-item.marked-review{background:var(--violet);border-color:var(--violet);color:#fff}
.grid-item.active-now{outline:3px solid var(--saffron);outline-offset:1px}
.drawer-submit-wrap{margin-top:14px}

.modal-overlay{position:fixed;inset:0;z-index:700;background:rgba(18,24,38,.5);display:none;align-items:center;justify-content:center;padding:20px}
.modal-box{background:#fff;border-radius:14px;padding:22px;width:100%;max-width:360px}
.modal-box h3{font-size:1.15rem;margin-bottom:12px}
.summary-list{display:flex;flex-direction:column;margin-bottom:14px}
.summary-item{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line);color:var(--muted)}
.summary-item strong{color:var(--ink)}
.confirm-btns{display:flex;gap:10px;margin-top:18px}
.confirm-btns .btn{min-height:46px}
.btn.ghost{background:#fff;color:var(--ink);border-color:var(--line)}


/* Language Selection Modal on Start Test */
#lang-select-modal{position:fixed;inset:0;z-index:800;background:rgba(18,24,38,.58);display:none;align-items:center;justify-content:center;padding:20px}
.lang-modal-box{background:#fff;border-radius:16px;padding:24px 20px;width:100%;max-width:380px;border:1px solid var(--line);box-shadow:0 12px 32px rgba(18,24,38,.18)}
.lang-modal-box h3{font-size:1.2rem;color:var(--navy);margin-bottom:4px}
.lang-modal-box p{font-size:.9rem;color:var(--muted);margin-bottom:18px}
.lang-choice-grid{display:flex;flex-direction:column;gap:12px}
.lang-choice-btn{display:flex;align-items:center;justify-content:space-between;width:100%;padding:14px 16px;border-radius:12px;border:1.5px solid var(--line);background:#fff;text-align:left;transition:border-color .15s,background-color .15s}
.lang-choice-btn:hover{border-color:var(--navy);background:#F5F7FC}
.lang-choice-btn b{display:block;font-size:1.05rem;color:var(--ink)}
.lang-choice-btn small{display:block;font-size:.82rem;color:var(--muted)}
.lang-choice-arrow{font-size:1.1rem;font-weight:700;color:var(--navy)}

/* Results / Dashboard */
#dashboard-screen{position:fixed;inset:0;z-index:900;background:var(--canvas);display:none;flex-direction:column;overflow-y:auto}
.dash-topbar{background:var(--navy);color:#fff;padding:max(18px,env(safe-area-inset-top)) 20px 18px}
.dash-topbar h1{font-size:1.25rem}
.dash-topbar p{color:#B9C4E8;font-size:.88rem}
.dash-container{max-width:760px;margin:0 auto;width:100%;padding:16px 14px 32px;display:flex;flex-direction:column;gap:14px}
.score-hero{display:flex;align-items:baseline;gap:8px;color:var(--muted)}
#res-total-marks{font-size:3.3rem;font-weight:700;line-height:1;color:var(--navy)}
.hero-sub{display:flex;gap:32px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}
.hero-sub b{display:block;font-size:1.3rem}
.hero-sub span{font-size:.82rem;color:var(--muted)}
.card h2{font-size:1rem;margin-bottom:4px}
.sec-row{display:grid;grid-template-columns:1fr auto;gap:6px 12px;padding:12px 0;border-top:1px solid var(--line)}
.sec-row:first-of-type{border-top:0}
.sec-score{font-weight:700}
.sec-bar{grid-column:1/-1;height:6px;border-radius:3px;background:var(--canvas);overflow:hidden}
.sec-bar i{display:block;height:100%;width:0;background:var(--navy)}
.trajectory-card-dark{background:#0F1A3D;border-radius:12px;padding:18px;color:#fff}
.traj-title{font-size:1rem;font-weight:600}
.traj-sub{font-size:.85rem;color:#9AA7C7;margin:2px 0 16px}
.canvas-box-exact{position:relative;width:100%;height:260px}
</style>
</head>
<body>

<div id="instruction-screen">
  <div class="inst-top"><div class="inst-wrap">
    <p>Official Pattern Mock Test</p>
    <h1>SSC CGL Tier 1<br>30 Sep, Shift 2</h1>
  </div></div>
  <div class="inst-wrap" style="padding:0 20px">
    <div class="inst-facts">
      <div><b>100</b><span>Questions</span></div>
      <div><b>200</b><span>Marks</span></div>
      <div><b>60</b><span>Minutes</span></div>
      <div><b>4</b><span>Sections</span></div>
    </div>
  </div>
  <div class="inst-body"><div class="inst-wrap">
    <h2>Sections &amp; Timing (15 minutes locked per section)</h2>
    <ol class="flow">
      <li>Reasoning<small>Q 1&ndash;25</small></li>
      <li>General Awareness<small>Q 26&ndash;50</small></li>
      <li>Quantitative Aptitude<small>Q 51&ndash;75</small></li>
      <li>English Comprehension<small>Q 76&ndash;100</small></li>
    </ol>
    <h2>Exam Rules</h2>
    <ul class="rules">
      <li>+2 marks for correct answers; -0.5 marks for wrong answers.</li>
      <li><strong>Real Exam Interface:</strong> During the exam, selecting an option will only mark your choice. Solutions will not be revealed until the full test is submitted.</li>
      <li>Detailed explanations alongside fastest shortcut tricks will be unlocked in <em>Review Solutions</em> mode after submission.</li>
      <li>You can toggle between English and Hindi at any moment using the top bar language switch.</li>
    </ul>
  </div></div>
  <div class="inst-cta"><button class="btn" onclick="startTest()">Start Test</button></div>
</div>

<div id="test-screen">
  <header class="top-header">
    <div class="test-name" id="current-section-title">PART-A: Reasoning</div>
    <div class="timer-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9 2h6"/></svg>
      <span id="section-timer-display">15:00</span>
    </div>
    <button class="lang-toggle-btn" id="lang-toggle-btn" onclick="toggleLanguage()">हिन्दी</button>
    <button class="menu-icon" onclick="openPalette()" aria-label="Question palette">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
    </button>
  </header>
  <nav class="section-bar">
    <div class="section-tab active" id="sec-tab-0">Reasoning</div>
    <div class="section-tab" id="sec-tab-1">GA</div>
    <div class="section-tab" id="sec-tab-2">Quant</div>
    <div class="section-tab" id="sec-tab-3">English</div>
  </nav>
  <div class="meta-row">
    <div class="meta-line">
      <span><b id="section-answered-badge">0</b> of 25 answered</span>
      <button class="save-btn" id="save-q-btn" onclick="toggleSaveQuestion()">Save</button>
    </div>
    <div class="prog"><i id="section-prog-bar"></i></div>
  </div>
  <main class="main-content"><div class="q-inner">
    <div class="q-badge-wrap">
      <span>Question <span class="q-no" id="curr-q-no">1</span></span>
      <span class="exam-tag-badge" id="exam-tag-text">Reasoning</span>
      <span class="per-q-timer-badge">Time: <span id="per-q-timer-text">00:00</span></span>
    </div>
    <div class="question-statement" id="question-text"></div>
    <div class="options-group" id="options-box"></div>
    <div class="explanation-box" id="explanation-container"></div>
  </div></main>
  <footer class="footer-bar" id="exam-footer-bar">
    <button class="nav-btn" id="prev-btn" onclick="prevQuestion()">Previous</button>
    <button class="nav-btn analysis" id="back-analysis-btn" onclick="returnToDashboard()">View Analysis</button>
    <button class="nav-btn" id="mark-btn" onclick="toggleMarkReview()">Mark for Review</button>
    <button class="nav-btn primary" id="next-btn" onclick="saveAndNext()">Save &amp; Next</button>
  </footer>
</div>

<div id="dashboard-screen">
  <div class="dash-topbar"><h1>Test Summary</h1><p>SSC CGL Tier 1, 30 Sep Shift 2</p></div>
  <div class="dash-container">
    <div class="card">
      <div class="score-hero"><span id="res-total-marks">0</span><span>out of 200</span></div>
      <div class="hero-sub">
        <div><b id="res-avg-score">0%</b><span>Accuracy</span></div>
        <div><b id="res-study-time">0m</b><span>Time Taken</span></div>
      </div>
    </div>
    <div class="card">
      <h2>Section Performance</h2>
      <div class="sec-row"><span>Reasoning</span><span class="sec-score" id="sec-score-0">0 / 50</span><div class="sec-bar"><i id="sec-bar-0"></i></div></div>
      <div class="sec-row"><span>General Awareness</span><span class="sec-score" id="sec-score-1">0 / 50</span><div class="sec-bar"><i id="sec-bar-1"></i></div></div>
      <div class="sec-row"><span>Quantitative Aptitude</span><span class="sec-score" id="sec-score-2">0 / 50</span><div class="sec-bar"><i id="sec-bar-2"></i></div></div>
      <div class="sec-row"><span>English Comprehension</span><span class="sec-score" id="sec-score-3">0 / 50</span><div class="sec-bar"><i id="sec-bar-3"></i></div></div>
    </div>
    <div class="trajectory-card-dark">
      <div class="traj-title">Performance Trajectory</div>
      <div class="traj-sub">Score Breakdown Across 4 Sections</div>
      <div class="canvas-box-exact"><canvas id="trajectoryLineChart"></canvas></div>
    </div>
    <button class="btn" onclick="closeDashboardToReview()">Review Solutions</button>
  </div>
</div>

<div id="palette-drawer" onclick="closePaletteOnBackdrop(event)">
  <div class="drawer-card">
    <div class="drawer-top"><h3>Question Palette</h3><button class="icon-btn" onclick="closePalette()">&#10005;</button></div>
    <div class="drawer-sec-badge" id="drawer-active-sec-badge"></div>
    <div class="legend-row">
      <span><i class="sq" style="background:var(--green);border-color:var(--green)"></i>Answered</span>
      <span><i class="sq" style="background:var(--violet);border-color:var(--violet)"></i>Marked</span>
      <span><i class="sq"></i>Not Answered</span>
    </div>
    <div class="grid-container" id="palette-grid"></div>
    <div class="drawer-submit-wrap"><button class="btn" id="drawer-submit-btn" onclick="openSubmitModal()">Submit Section</button></div>
  </div>
</div>

<div class="modal-overlay" id="submit-confirm-modal">
  <div class="modal-box">
    <h3 id="modal-heading-text">Submit Section</h3>
    <div class="summary-list">
      <div class="summary-item"><span>Time Left</span><strong id="modal-time-left">--:--</strong></div>
      <div class="summary-item"><span>Attempted</span><strong id="modal-attempted">0</strong></div>
      <div class="summary-item"><span>Unattempted</span><strong id="modal-unattempted">25</strong></div>
      <div class="summary-item"><span>Marked for Review</span><strong id="modal-marked">0</strong></div>
    </div>
    <p id="modal-subtext" style="font-size:0.85rem;color:var(--muted);margin-bottom:12px;"></p>
    <div class="confirm-btns">
      <button class="btn ghost" onclick="closeSubmitModal()">Resume</button>
